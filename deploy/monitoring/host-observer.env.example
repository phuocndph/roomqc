# Metadata and absolute Linux file paths only. Keep the actual files private.
# Load the verified image on the manager before starting; pull_policy is never.
ROOMQC_HOST_OBSERVER_PROJECT=roomqc-host-observer
ROOMQC_HOST_OBSERVER_IMAGE=roomqc/host-observer@sha256:REPLACE_WITH_VERIFIED_DIGEST
ROOMQC_RESOURCE_ENVIRONMENT=production
ROOMQC_HOST_OBSERVER_INSTANCES=1
ROOMQC_RESOURCE_BUDGET_FILE=/etc/roomqc/resource-budget.json
ROOMQC_HOST_OBSERVER_TARGETS_FILE=/etc/roomqc/observer/hosts.json
ROOMQC_HOST_OBSERVER_DATABASE_URL_FILE=/etc/roomqc/observer/observer-dsn
ROOMQC_HOST_OBSERVER_SSH_KEY_FILE=/etc/roomqc/observer/observer-key
ROOMQC_HOST_OBSERVER_KNOWN_HOSTS_FILE=/etc/roomqc/observer/known_hosts
ROOMQC_HOST_OBSERVER_CA_FILE=/etc/roomqc/observer/directory-ca.pem
ROOMQC_HOST_OBSERVER_DIRECTORY_NETWORK=roomqc-directory
