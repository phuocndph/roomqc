[Unit]
Description=RoomQC read-only VPS resource observer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=roomqc-observer
Group=roomqc-observer
WorkingDirectory=/opt/RoomQC/host-observer
EnvironmentFile=/etc/roomqc-host-observer/environment
ExecStart=/usr/bin/node /opt/RoomQC/host-observer/scripts/roomqc-host-observer.mjs --targets-file /etc/roomqc-host-observer/targets.json --database-url-file /var/lib/roomqc-host-observer/directory.dsn --watch --interval-seconds 60 --status-file /var/lib/roomqc-host-observer/status.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
MemoryMax=192M
CPUQuota=25%
TasksMax=64
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/roomqc-host-observer
UMask=0077

[Install]
WantedBy=multi-user.target
