# Disposable local SSH target only. Never deploy this image to a customer VPS.
FROM docker:cli@sha256:1a4c7cb63513f349bdad01fcc6e0f3f2f67d37b9da86f14dc0d4a0942eecda00
RUN apk add --no-cache openssh-server openssl util-linux coreutils procps && passwd -d root \
  && mkdir -p /root/.ssh /run/sshd && chmod 700 /root/.ssh \
  && printf '%s\n' 'PermitRootLogin prohibit-password' 'PasswordAuthentication no' \
    'KbdInteractiveAuthentication no' 'AllowTcpForwarding local' > /etc/ssh/sshd_config.d/roomqc-test.conf
ENTRYPOINT ["sh", "-c", "ssh-keygen -A >/dev/null 2>&1 && exec /usr/sbin/sshd -D -e"]
