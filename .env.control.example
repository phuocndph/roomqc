# SERVER ONLY. Copy to .env.control; never put these values in VITE_*.
NODE_ENV=production
ROOMQC_PUBLIC_URL=https://roomqc.com
ROOMQC_CONTROL_HOST=127.0.0.1
ROOMQC_CONTROL_PORT=8091
# Explicit canonical authority for platform support. Empty disables support APIs.
ROOMQC_CONTROL_SUPPORT_CLUSTER_ID=
# Staging/pilot opt-in only. Public signup still needs bot protection at the edge.
ROOMQC_CONTROL_SIGNUP_ENABLED=false
# New unused reservations last 24h. Provisioning/active workspaces never expire.
ROOMQC_CONTROL_RESERVATION_MINUTES=1440
# Durable limits shared by all control replicas. They count even expired intents.
ROOMQC_CONTROL_SIGNUP_HOUR_LIMIT=100
ROOMQC_CONTROL_EMAIL_DAY_LIMIT=3
# Separate managed PostgreSQL database; require TLS verification in production.
ROOMQC_CONTROL_DATABASE_URL=postgresql://control_user:CHANGE_ME@control-db.example.com:5432/roomqc_control?sslmode=verify-full
# Stable HMAC key: changing it requires an explicit email hash migration.
ROOMQC_CONTROL_EMAIL_HASH_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Actual keys must stay in this server-side file. Identical platform VAPID public
# key across clusters is needed for a shared-origin browser Push subscription.
ROOMQC_CONTROL_CLUSTERS='[{"id":"cluster-a","url":"https://PROJECT.supabase.co","publishableKey":"PUBLIC_KEY","serviceKey":"SERVER_ONLY_KEY","vapidPublicKey":"PLATFORM_VAPID_PUBLIC_KEY","maxWorkspaces":100}]'
