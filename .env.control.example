# SERVER ONLY. Copy to .env.control; never put these values in VITE_*.
NODE_ENV=production
ROOMQC_PUBLIC_URL=https://roomqc.com
ROOMQC_CONTROL_HOST=127.0.0.1
ROOMQC_CONTROL_PORT=8091
ROOMQC_CONTROL_POOL_MAX=5
# Aggregate budget across API replicas, workers, monitoring and migration sessions.
ROOMQC_CONTROL_POOL_BUDGET=20
ROOMQC_CONTROL_SHUTDOWN_TIMEOUT_MS=25000
# Explicit canonical authority for platform support. Empty disables support APIs.
ROOMQC_CONTROL_SUPPORT_CLUSTER_ID=
# Staging/pilot opt-in only. Public signup still needs bot protection at the edge.
ROOMQC_CONTROL_SIGNUP_ENABLED=false
# New unused reservations last 24h. Provisioning/active workspaces never expire.
ROOMQC_CONTROL_RESERVATION_MINUTES=1440
# Durable limits shared by all control replicas. They count even expired intents.
ROOMQC_CONTROL_SIGNUP_HOUR_LIMIT=100
ROOMQC_CONTROL_EMAIL_DAY_LIMIT=3
# Separate managed PostgreSQL database; require TLS verification in production.
ROOMQC_CONTROL_DATABASE_URL=postgresql://control_user:CHANGE_ME@control-db.example.com:5432/roomqc_control?sslmode=verify-full
# Migration CLI/job only, direct DB/session connection (not transaction pooling).
# The compose API explicitly clears this variable so the credential stays outside it.
ROOMQC_CONTROL_MIGRATION_DATABASE_URL=postgresql://control_migrator:CHANGE_ME@control-db.example.com:5432/roomqc_control?sslmode=verify-full
# Stable HMAC key: changing it requires an explicit email hash migration.
ROOMQC_CONTROL_EMAIL_HASH_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Actual keys must stay in this server-side file. Identical platform VAPID public
# key across clusters is needed for a shared-origin browser Push subscription.
ROOMQC_CONTROL_CLUSTERS='[{"id":"cluster-a","url":"https://PROJECT.supabase.co","publishableKey":"PUBLIC_KEY","serviceKey":"SERVER_ONLY_KEY","vapidPublicKey":"PLATFORM_VAPID_PUBLIC_KEY","maxWorkspaces":100}]'
# Optional approved inventory. Without a verified release/frontend/backup/health,
# a bootstrap cluster stays closed to new registrations. Metadata lives in DB;
# this inventory restricts the endpoints and secret references it may select.
# Empty approvedAddresses permits only globally public DNS answers; private
# addresses require exact IP approval. Metadata/link-local targets are denied.
# Local-only loopback/host.docker.internal exceptions require ALLOW_LOCAL=true.
# ROOMQC_CONTROL_INVENTORY='[{"id":"cluster-a","hostId":"host-a","hostName":"RoomQC data A","environment":"production","backendKind":"self_hosted","credentialRef":"cluster-a","url":"https://api-a.roomqc.com","approvedAddresses":[],"releaseId":"VERIFIED_RELEASE","schemaManifestHash":"VERIFIED_64_HEX_SCHEMA_HASH","frontendReady":false}]'
# Additional credentials are server-only, never part of the admin registration body.
# ROOMQC_CONTROL_CREDENTIALS='[{"ref":"cluster-b","publishableKey":"PUBLIC_KEY","serviceKey":"SERVER_ONLY_KEY","vapidPublicKey":"PLATFORM_VAPID_PUBLIC_KEY"}]'
