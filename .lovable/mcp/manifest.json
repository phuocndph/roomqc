        "name": "list_hotels",
        "title": "Danh sách khách sạn",
        "description": "Liệt kê các khách sạn thuộc đơn vị của người dùng đang đăng nhập.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
