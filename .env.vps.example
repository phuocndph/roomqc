# Copy to .env.vps on the VPS and replace every placeholder.
# This key is the Supabase publishable/anon key and is safe for a browser bundle.
ROOMQC_ENVIRONMENT=vps
ROOMQC_BIND=127.0.0.1
ROOMQC_PORT=8082
VITE_SUPABASE_PROJECT_ID=replace_with_new_project_ref
VITE_SUPABASE_URL=https://replace_with_your_supabase_api_url
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
VITE_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VITE_ENABLE_DEMO_DATA=false
