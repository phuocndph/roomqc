# Server-side only. Copy to supabase/functions/.env for local Edge Runtime.
ROOMQC_EMAIL_ENVIRONMENT=local
ROOMQC_EMAIL_PROVIDER=mailpit
ROOMQC_PUBLIC_URL=http://127.0.0.1:8082
ROOMQC_EMAIL_FROM=notifications@roomqc.test
ROOMQC_EMAIL_FROM_NAME=RoomQC
ROOMQC_EMAIL_REPLY_TO=
ROOMQC_MAILPIT_URL=http://supabase_inbucket_ehjtoajnlnuvuiwkpmbp:8025
# Set provider=resend for a verified production sender. Never prefix these with VITE_.
RESEND_API_KEY=
ROOMQC_EMAIL_WEBHOOK_SECRET=
# Required for Resend in local/staging: exact recipient addresses, comma-separated.
ROOMQC_EMAIL_TEST_RECIPIENTS=
