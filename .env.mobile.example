# Copy to .env.mobile.local. Public settings only: NEVER put a service_role,
# password, FCM server key, Apple key, or signing secret in VITE_* variables.
VITE_ROOMQC_PUBLIC_WEB_URL=https://app.your-domain.com
VITE_SUPABASE_URL=https://api.your-domain.com
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_ROOMQC_DIRECTORY_ENABLED=true
VITE_ROOMQC_CLUSTER_ORIGINS=https://api.your-domain.com
VITE_ENABLE_DEMO_DATA=false
# --local: explicit development-only build. Android emulator uses
# http://10.0.2.2:54321 for Supabase and http://10.0.2.2:8082 for the web.
# A real phone needs your computer's LAN address, not localhost / 10.0.2.2.
